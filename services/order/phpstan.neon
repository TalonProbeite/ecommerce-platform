includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - routes/
        - database/
    level: 8
    excludePaths:
        - vendor/*
        - storage/*
        - bootstrap/cache/*
    ignoreErrors:
        -
            identifier: missingType.generics
            path: app/Infrastructure/Persistence/Models/*
