# Copy to .env before running the local stack:
#   cp .env.example .env && php artisan key:generate
# Values marked REQUIRED have no safe default and must be filled in.

APP_NAME=OrderMicroservice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# -----------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=order_db
DB_USERNAME=admin
DB_PASSWORD=secret

# -----------------------------------------------------
# REDIS
# -----------------------------------------------------

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381
REDIS_DB=0

# -----------------------------------------------------
# QUEUE
# -----------------------------------------------------

QUEUE_CONNECTION=sync

# -----------------------------------------------------
# RABBITMQ
# -----------------------------------------------------

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5675
RABBITMQ_USER=order
RABBITMQ_PASSWORD=order_secret
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=order.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_EXCHANGE_DURABLE=true

# Consumer of catalog.events. Exchange/queue names must match the shared
# messaging contract.
INBOUND_CATALOG_EXCHANGE=catalog.events
INBOUND_CATALOG_QUEUE=order.catalog-events
INBOUND_CATALOG_DLX_EXCHANGE=order.catalog-events.dlx
INBOUND_CATALOG_DEAD_QUEUE=order.catalog-events.dead
INBOUND_CATALOG_PREFETCH=1
INBOUND_CATALOG_DELIVERY_LIMIT=5
INBOUND_CATALOG_RETRY_DELAY_MS=500
INBOUND_CATALOG_RECONNECT_DELAY_MS=1000
INBOUND_CATALOG_WAIT_TIMEOUT=1.0

# -----------------------------------------------------
# OUTBOX RELAY
# -----------------------------------------------------

OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_IDLE_SLEEP_MS=100
OUTBOX_MAX_BATCHES=
OUTBOX_OBSERVER_ENABLED=false

# -----------------------------------------------------
# JWT
# -----------------------------------------------------
# REQUIRED for /api/v1 routes and /readyz: base64-encoded PEM RSA public key.
# Use the same key that Auth Service exposes as JWT_PUBLIC_KEY_BASE64
# (the variable names differ between services, the key value is the same).

JWT_PUBLIC_KEY_B64=
JWT_ALGO=RS256

# -----------------------------------------------------
# STRIPE
# -----------------------------------------------------
# REQUIRED for the local Compose stack: order-stripe-cli refuses to start
# without a non-empty STRIPE_SECRET. Use a Stripe test-mode key (sk_test_...).
# STRIPE_WEBHOOK_SECRET (whsec_...) is optional locally; stripe-cli prints it
# on startup and it is only needed when the webhook endpoint is exercised.

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=EUR
STRIPE_API_VERSION=

# -----------------------------------------------------
# OCTANE
# -----------------------------------------------------

OCTANE_SERVER=roadrunner
