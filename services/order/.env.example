APP_NAME=OrderMicroservice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# -----------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=order_db
DB_USERNAME=admin
DB_PASSWORD=secret

# -----------------------------------------------------
# REDIS
# -----------------------------------------------------

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381
REDIS_DB=0

# -----------------------------------------------------
# QUEUE
# -----------------------------------------------------

QUEUE_CONNECTION=sync

# -----------------------------------------------------
# RABBITMQ
# -----------------------------------------------------

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5675
RABBITMQ_USER=order
RABBITMQ_PASSWORD=order_secret
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=order.events

# Consumer of catalog.events. Exchange/queue names must match the shared
# messaging contract.
INBOUND_CATALOG_EXCHANGE=catalog.events
INBOUND_CATALOG_QUEUE=order.catalog-events
INBOUND_CATALOG_DLX_EXCHANGE=order.catalog-events.dlx
INBOUND_CATALOG_DEAD_QUEUE=order.catalog-events.dead

# -----------------------------------------------------
# OUTBOX RELAY
# -----------------------------------------------------

OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_IDLE_SLEEP_MS=100

# -----------------------------------------------------
# JWT
# -----------------------------------------------------

JWT_PUBLIC_KEY_B64=
JWT_ALGO=RS256
JWT_ISSUER=
JWT_AUDIENCE=

# -----------------------------------------------------
# STRIPE
# -----------------------------------------------------

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=EUR

# -----------------------------------------------------
# OCTANE
# -----------------------------------------------------

OCTANE_SERVER=roadrunner
