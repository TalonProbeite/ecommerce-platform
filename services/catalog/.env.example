APP_NAME=CatalogMicroservice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# -----------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=catalog_db
DB_USERNAME=admin
DB_PASSWORD=secret

# -----------------------------------------------------
# REDIS
# -----------------------------------------------------

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

# -----------------------------------------------------
# QUEUE
# -----------------------------------------------------

QUEUE_CONNECTION=sync

# -----------------------------------------------------
# SEAWEEDFS (S3 API)
# -----------------------------------------------------

FILESYSTEM_DISK=seaweedfs
CATALOG_IMAGES_DISK=seaweedfs

SEAWEEDFS_ACCESS_KEY_ID=seaweed_admin
SEAWEEDFS_SECRET_ACCESS_KEY=seaweed_secret_123
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_BUCKET=catalog
SEAWEEDFS_ENDPOINT=http://127.0.0.1:8333

# Public URL served by the catalog Nginx /media/<bucket> route. It must not use
# the internal catalog-seaweedfs hostname; Laravel appends the object key.
# Root global stack:        https://localhost/catalog/media/catalog
# Isolated catalog stack:   https://localhost:8444/media/catalog
# Production gateway:       https://<host>/catalog/media/catalog
SEAWEEDFS_PUBLIC_URL=https://localhost/catalog/media/catalog

# -----------------------------------------------------
# OCTANE
# -----------------------------------------------------

OCTANE_SERVER=roadrunner