# Copy this file to .env.local and adjust it for your environment.
# Leave secrets out: every VITE_* value is exposed to the browser.

# "mock" keeps local fixtures; "real" talks to the configured backend.
VITE_API_MODE=mock

# Backend origin. Required when VITE_API_MODE=real.
VITE_API_URL=https://localhost

# Real checkout stays disabled by default while the Order Service contract is a draft.
VITE_ENABLE_REAL_CHECKOUT=false
