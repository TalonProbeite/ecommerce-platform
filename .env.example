# Global RabbitMQ settings
RABBITMQ_HOST=global-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Public origins for the global HTTPS stack
FRONTEND_URL=https://localhost
FRONTEND_API_URL=https://localhost

# Stripe test publishable key baked into the frontend build (pk_test_...).
# The matching STRIPE_SECRET and STRIPE_WEBHOOK_SECRET live in services/order/.env.
STRIPE_PUBLISHABLE_KEY=
